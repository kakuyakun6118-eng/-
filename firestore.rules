rules_version = '2';

// Anyone who has anonymously signed in (which the app does automatically)
// can read/write this trip's data. There is no login screen — this is
// "good enough" privacy for a personal trip planner, not bank-grade
// security. See README.md for details/limitations.
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripId} {
      allow read, write: if request.auth != null;

      match /places/{placeId} {
        allow read, write: if request.auth != null;
      }

      match /scheduleItems/{itemId} {
        allow read, write: if request.auth != null;
      }

      // English-phrase learning progress, one document per traveller.
      match /learners/{learnerId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
