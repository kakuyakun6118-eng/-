{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tsc-cache/node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["vite.config.ts"]
}
