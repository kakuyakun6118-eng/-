# Claude API key for news-impact judgment (src/lib/llm.ts)
ANTHROPIC_API_KEY=
# Optional: override the default model (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=

# X (Twitter) API v2 Bearer Token, for reading watched accounts' own public
# posts (src/lib/socialSource.ts, /watch page). Requires a paid X API plan.
# Without this, /watch shows a "not configured" notice and no posts.
X_BEARER_TOKEN=
