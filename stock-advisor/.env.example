# Claude API key for news-impact judgment (src/lib/llm.ts)
ANTHROPIC_API_KEY=
# Optional: override the default model (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=

# X (Twitter) API v2 Bearer Token, for reading watched accounts' own public
# posts (src/lib/socialSource.ts, /watch page). Requires a paid X API plan.
# Without this, /watch shows a "not configured" notice and no posts.
X_BEARER_TOKEN=

# --- Notifications (POST /api/notify) ---
# Each channel is optional; unconfigured channels are skipped.

# Discord: Server Settings → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_URL=

# LINE: Messaging API channel access token + the recipient's user ID.
# (LINE Notify was discontinued on 2025-03-31, so a Messaging API channel
# created in the LINE Developers console is required.)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
