# --- Required for the LLM judgments ---
# The only paid dependency. Without it the app still runs, but the news-impact
# and 紫蘇の葉理論 content judgments are skipped and shown as neutral.
ANTHROPIC_API_KEY=
# Optional: override the default model (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=

# --- Data sources (no keys needed) ---
# News comes from Google News RSS and prices from Yahoo Finance; neither
# requires an account. How many articles to pull per ticker — rule 1 of the
# theory counts these, so the feed has to reach back past a single day.
NEWS_FEED_SIZE=60

# How many tickers are enriched at once (quote + news + LLM per ticker).
# Higher values are faster but raise the chance of provider rate limiting.
ENRICH_CONCURRENCY=4

# --- Notifications (POST /api/notify) ---
# Each channel is optional; unconfigured channels are skipped.

# Discord: Server Settings → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_URL=

# LINE: Messaging API channel access token + the recipient's user ID.
# (LINE Notify was discontinued on 2025-03-31, so a Messaging API channel
# created in the LINE Developers console is required.)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=

# --- Access control ---
# Password for the browser UI. REQUIRED before putting the app on the internet:
# leave it blank and anyone with the URL can read and edit your holdings.
# Blank is fine for a purely local (localhost / home LAN) setup.
APP_PASSWORD=

# Optional. Sessions are signed with a key derived from APP_PASSWORD, so
# changing the password signs you out everywhere. Set this to a long random
# string to keep sessions alive across password changes.
SESSION_SECRET=

# Shared secret for the cron-driven endpoints (/api/notify, /api/history/record),
# which cannot log in. Send it as `Authorization: Bearer <token>` or
# `X-App-Token: <token>`.
APP_TOKEN=
