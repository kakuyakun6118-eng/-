# Copy this file to .env.local for local development (npm run dev).
# For the deployed (GitHub Pages) version, set these as GitHub repo secrets
# instead — see README.md.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Any short string; both phones must use the same value to see the same trip.
VITE_TRIP_ID=ny-2026-09
